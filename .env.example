# =============================================================================
# Bridge Ecosystem — environment template
# Development-only defaults allow this file to boot the local Compose stack.
# Copy to .env and replace every credential before any non-local deployment.
# Lab:    docker compose up --build -d
# Prod:   docker compose -f docker-compose.prod.yml --env-file .env up -d
# Profiles: mongodb | mssql | databases | full
# =============================================================================

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
BRIDGE_DOMAIN=example.com
NODE_ENV=
BRIDGE_DEMO_MODE=1
BRIDGE_API_URL=http://localhost:4000
# Lab: http://localhost:4000  |  Prod: https://api.example.com
VITE_BRIDGE_API_URL=http://localhost:4000
# Lab: http://localhost:5173  |  Prod: https://control.example.com
BRIDGE_CORS_ORIGINS=http://localhost:5173
# Lab defaults below; prod compose forces JWT=1, TRUST_HEADERS=0, SECRETS=aws-kms
BRIDGE_REQUIRE_JWT=0
BRIDGE_TRUST_HEADERS=1
BRIDGE_RATE_LIMIT=300
BRIDGE_QUARANTINE_DIR=/data/quarantine

# -----------------------------------------------------------------------------
# Postgres (control-plane SoR)
# -----------------------------------------------------------------------------
POSTGRES_DB=bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge_dev_only

# -----------------------------------------------------------------------------
# WordPress / MariaDB
# -----------------------------------------------------------------------------
WP_DB_PASSWORD=wordpress_dev_only

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# NATS / JetStream (outbox-relay + provision-worker)
# -----------------------------------------------------------------------------
NATS_URL=nats://nats:4222
BRIDGE_JS_STREAM=BRIDGE_EVENTS
BRIDGE_JS_DURABLE=PROVISION_WORKER_V1
BRIDGE_JS_FILTER=provision.requested
BRIDGE_JS_ACK_WAIT_NS=30000000000
BRIDGE_JS_MAX_DELIVER=5
BRIDGE_JS_SUBJECTS=bridge.>,provision.>,billing.>,workflow.>,agent.>,audit.>
OUTBOX_POLL_MS=1000
OUTBOX_BATCH=50

# -----------------------------------------------------------------------------
# OIDC / Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=bridgeadmin
KEYCLOAK_ADMIN_PASSWORD=BridgeAdmin!Demo2026
# Lab: http://localhost:8181/realms/bridge
# Prod: https://auth.example.com/realms/bridge
BRIDGE_JWT_ISSUER=http://localhost:8181/realms/bridge
VITE_OIDC_AUTHORITY=http://localhost:8181/realms/bridge
BRIDGE_JWT_AUDIENCE=bridge-api
BRIDGE_JWKS_URL=

# -----------------------------------------------------------------------------
# KMS / secrets
# Lab: BRIDGE_SECRETS_PROVIDER=lab + BRIDGE_SECRETS_KEY
# Prod: BRIDGE_SECRETS_PROVIDER=aws-kms + BRIDGE_KMS_KEY_ID + AWS creds/role
# -----------------------------------------------------------------------------
BRIDGE_SECRETS_PROVIDER=lab
BRIDGE_SECRETS_KEY=bridge-lab-secrets-key-change-me
BRIDGE_KMS_KEY_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BRIDGE_ALLOW_LAB_SECRETS_IN_PROD=0

# -----------------------------------------------------------------------------
# Cloudflare (WAF/DNS API used by platform adapters)
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# -----------------------------------------------------------------------------
# TLS / Traefik ACME (production compose only)
# DNS-01 via Cloudflare — token needs Zone:DNS:Edit
# -----------------------------------------------------------------------------
ACME_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=

# -----------------------------------------------------------------------------
# MongoDB (profiles: mongodb | databases)
# -----------------------------------------------------------------------------
MONGO_ROOT_USER=bridge
MONGO_ROOT_PASSWORD=
MONGODB_URL=

# -----------------------------------------------------------------------------
# MSSQL (profiles: mssql | databases)
# -----------------------------------------------------------------------------
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=0
MSSQL_TRUST_CERT=1

# -----------------------------------------------------------------------------
# ClickHouse (profile: full)
# Wire when running with --profile full:
#   CLICKHOUSE_URL=http://clickhouse:8123
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
BRIDGE_AI_BASE_URL=
BRIDGE_AI_API_KEY=
BRIDGE_AI_MODEL=

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
BRIDGE_MCP_KEY=

# -----------------------------------------------------------------------------
# Observability (profile: full)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=grafana_dev_only
