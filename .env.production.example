# Production deployment template. Copy to .env outside source control and replace every placeholder.
BRIDGE_DOMAIN=example.com
POSTGRES_DB=bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=
WP_DB_PASSWORD=

# Production authentication and browser clients.
BRIDGE_REQUIRE_JWT=1
BRIDGE_TRUST_HEADERS=0
BRIDGE_JWT_ISSUER=https://auth.example.com/realms/bridge
BRIDGE_JWT_AUDIENCE=bridge-api
BRIDGE_CORS_ORIGINS=https://control.example.com,https://puck.example.com
VITE_BRIDGE_API_URL=https://api.example.com
VITE_OIDC_AUTHORITY=https://auth.example.com/realms/bridge
VITE_OIDC_CLIENT_ID=bridge-control-center
VITE_OIDC_REDIRECT_URI=https://control.example.com/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://control.example.com/
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_ENABLED=1
VITE_REQUIRE_AUTH=1
VITE_PUCK_HOST_URL=https://puck.example.com

# Do not use lab AES-GCM secrets in production.
BRIDGE_SECRETS_PROVIDER=aws-kms
BRIDGE_ALLOW_LAB_SECRETS_IN_PROD=0
BRIDGE_KMS_KEY_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
ACME_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
BRIDGE_MCP_KEY=

# Optional database providers. Leave absent unless the relevant Compose profile is enabled.
MONGODB_URL=
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=1
MSSQL_TRUST_CERT=0
