FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_BRIDGE_API_URL=http://localhost:4000
ARG VITE_API_BASE_URL=
ARG VITE_OIDC_AUTHORITY=http://localhost:8181/realms/bridge
ARG VITE_OIDC_CLIENT_ID=bridge-control-center
ARG VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
ARG VITE_OIDC_SCOPE=openid profile email
ARG VITE_OIDC_ENABLED=0
ARG VITE_REQUIRE_AUTH=0
ARG VITE_PUCK_HOST_URL=http://localhost:5174
ENV VITE_BRIDGE_API_URL=$VITE_BRIDGE_API_URL \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI \
    VITE_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_OIDC_POST_LOGOUT_REDIRECT_URI \
    VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE \
    VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED \
    VITE_REQUIRE_AUTH=$VITE_REQUIRE_AUTH \
    VITE_PUCK_HOST_URL=$VITE_PUCK_HOST_URL
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
