    "oidc-client-ts": "^3.1.0",
    "solid-js": "^1.9.6",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/three": "^0.175.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.1.2",
    "@playwright/test": "^1.52.0"
  }
}
